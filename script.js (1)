let currentWeek=1;
let currentQuestionIndex = 0;
let studentName = "";
let score = 0;
let timer;
let timeLeft = 30;
let userAnswers = [];
let quizActive = false;

// DOM Elements
const homePage = document.getElementById('home-page');
const quizPage = document.getElementById('quiz-page');
const resultPage = document.getElementById('result-page');

const studentNameInput = document.getElementById('student-name');
const weekSelect = document.getElementById('week-select');
const startBtn = document.getElementById('start-btn');

const displayStudentName = document.getElementById('display-student-name');
const displayWeek = document.getElementById('display-week');
const timerText = document.getElementById('timer-text');
const progressBar = document.getElementById('progress-bar');

const questionText = document.getElementById('question-text');
const optionsContainer = document.getElementById('options-container');

const prevBtn = document.getElementById('prev-btn');
const nextBtn = document.getElementById('next-btn');

const finalScoreText = document.getElementById('final-score-text');
const percentageText = document.getElementById('percentage-text');
const passFailMessage = document.getElementById('pass-fail-message');
const reviewList = document.getElementById('review-list');
const restartBtn = document.getElementById('restart-btn');

// Initialize Week Selection
function init() {
    for (let i = 1; i <= 6; i++) {
        const option = document.createElement('option');
        option.value = i;
        option.textContent = `Week ${i}`;
        weekSelect.appendChild(option);
    }
}

// Start Quiz
startBtn.addEventListener('click', () => {
    studentName = studentNameInput.value.trim();
    if (!studentName) {
        alert("Please enter your name!");
        return;
    }
    currentWeek = parseInt(weekSelect.value);
    startQuiz();
});

function startQuiz() {
    quizActive = true;
    currentQuestionIndex = 0;
    score = 0;
    userAnswers = new Array(quizData[currentWeek].length).fill(null);
    
    homePage.classList.add('hidden');
    resultPage.classList.add('hidden');
    quizPage.classList.remove('hidden');
    
    displayStudentName.textContent = studentName;
    displayWeek.textContent = `Week ${currentWeek}`;
    
    showQuestion();
}

function showQuestion() {
    if (!quizActive) return;

    clearInterval(timer);
    timeLeft = 30;
    updateTimerDisplay();
    startTimer();

    const currentQuestions = quizData[currentWeek];
    const question = currentQuestions[currentQuestionIndex];

    // Update Progress Bar
    const progress = ((currentQuestionIndex + 1) / currentQuestions.length) * 100;
    progressBar.style.width = `${progress}%`;

    // Set Question Text
    questionText.textContent = `${currentQuestionIndex + 1}. ${question.q}`;

    // Set Options
    optionsContainer.innerHTML = '';
    question.a.forEach((option, index) => {
        const label = document.createElement('label');
        label.className = 'option-label';
        if (userAnswers[currentQuestionIndex] === index) {
            label.classList.add('selected');
        }
        
        label.innerHTML = `
            <input type="radio" name="quiz-option" value="${index}" ${userAnswers[currentQuestionIndex] === index ? 'checked' : ''}>
            <span>${option}</span>
        `;
        
        label.addEventListener('change', () => {
            selectOption(index);
        });
        
        optionsContainer.appendChild(label);
    });

    // Update button visibility
    prevBtn.disabled = currentQuestionIndex === 0;
  nextBtn.innerHTML = currentQuestionIndex === currentQuestions.length - 1
    ? 'Finish <i class="fas fa-check"></i>'
    : 'Next <i class="fas fa-arrow-right"></i>';
}

function selectOption(index) {
    userAnswers[currentQuestionIndex] = index;
    
    // Update UI for selected option
    const labels = optionsContainer.querySelectorAll('.option-label');
    labels.forEach((label, i) => {
        if (i === index) {
            label.classList.add('selected');
        } else {
            label.classList.remove('selected');
        }
    });
}

function startTimer() {
    timer = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        if (timeLeft <= 0) {
            clearInterval(timer);
            autoSubmit();
        }
    }, 1000);
}

function updateTimerDisplay() {
    timerText.textContent = timeLeft;
    // Visual feedback for low time
    if (timeLeft <= 5) {
        timerText.parentElement.style.borderColor = 'var(--error-color)';
        timerText.style.color = 'var(--error-color)';
    } else {
        timerText.parentElement.style.borderColor = 'var(--primary-color)';
        timerText.style.color = 'var(--primary-color)';
    }
}

function autoSubmit() {
    // If no answer selected, it remains null
    nextQuestion();
}

function nextQuestion() {
    const currentQuestions = quizData[currentWeek];
    if (currentQuestionIndex < currentQuestions.length - 1) {
        currentQuestionIndex++;
        showQuestion();
    } else {
        finishQuiz();
    }
}

function prevQuestion() {
    if (currentQuestionIndex > 0) {
        currentQuestionIndex--;
        showQuestion();
    }
}

prevBtn.addEventListener('click', prevQuestion);
nextBtn.addEventListener('click', () => {
    if (currentQuestionIndex === quizData[currentWeek].length - 1) {
        finishQuiz();
    } else {
        nextQuestion();
    }
});

function finishQuiz() {
    quizActive = false;
    clearInterval(timer);
    
    // Calculate score
    score = 0;
    const currentQuestions = quizData[currentWeek];
    currentQuestions.forEach((q, index) => {
        if (userAnswers[index] === q.c) {
            score++;
        }
    });

    const percentage = Math.round((score / currentQuestions.length) * 100);
    
    quizPage.classList.add('hidden');
    resultPage.classList.remove('hidden');

    finalScoreText.textContent = `${score}/${currentQuestions.length}`;
    percentageText.textContent = `${percentage}%`;
    
    if (percentage >= 50) {
        passFailMessage.textContent = "Congratulations! You Passed! 🎉";
        passFailMessage.className = "status-correct";
    } else {
        passFailMessage.textContent = "Don't give up! Try again! 📚";
        passFailMessage.className = "status-wrong";
    }
  fetch("https://script.google.com/macros/s/AKfycbyam5KczJf3X9RqeYpcv5NpX7kGCZPHCkJvoFCQM0h8u-IgCU4Rz6qe1i3189o5AwkBxw/exec", {
  method: "POST",
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    name: studentName,
    week: currentWeek,
    score: score
  })
})
.then(response => response.text())
.then(data => console.log("Saved:", data))
.catch(error => console.error("Error:", error));

    showReview();
}

function showReview() {
    reviewList.innerHTML = '';
    const currentQuestions = quizData[currentWeek];
    
    currentQuestions.forEach((q, index) => {
        const reviewItem = document.createElement('div');
        reviewItem.className = 'review-item';
        
        const isCorrect = userAnswers[index] === q.c;
        const userAnsText = userAnswers[index] !== null ? q.a[userAnswers[index]] : "No answer";
        const correctAnsText = q.a[q.c];

        reviewItem.innerHTML = `
            <span class="q-text">${index + 1}. ${q.q}</span>
            <div class="q-status ${isCorrect ? 'status-correct' : 'status-wrong'}">
                ${isCorrect ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-times-circle"></i>'} 
                Your answer: ${userAnsText} 
                ${!isCorrect ? ` | <span class="status-correct">Correct: ${correctAnsText}</span>` : ''}
            </div>
        `;
        reviewList.appendChild(reviewItem);
    });
}

restartBtn.addEventListener('click', () => {
    resultPage.classList.add('hidden');
    homePage.classList.remove('hidden');
});

